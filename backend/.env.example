# ==============================================================================
# M-FTAMS Central Backend — Environment Configuration
# ==============================================================================

# Server Port (Render sets this automatically via process.env.PORT)
PORT=8080

# Environment Mode (development / production)
NODE_ENV=production

# JWT Authentication Secret Key (Used for HMAC signing of access/refresh tokens)
JWT_SECRET=mftams_jwt_production_secret_key_cantonment_2026

# Central Master HMAC Key for Token Verification and Audit Chaining
HMAC_MASTER_KEY=mftams_central_hmac_master_key_99482715_cantonment

# Optional Database Configuration (Defaults to in-memory database if omitted)
# DATABASE_URL=postgres://user:password@hostname:5432/mftams_db
