{
  "name": "m-ftams-monorepo",
  "version": "1.0.0",
  "description": "M-FTAMS — Military Fleet Transportation & Access Management System Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "edge-backend",
    "edge-simulator",
    "frontend-dashboard",
    "frontend-kiosk"
  ],
  "scripts": {
    "build": "npm --prefix backend run build && npm --prefix edge-backend run build && npm --prefix frontend-kiosk run build && npm --prefix frontend-dashboard run build",
    "build:backend": "npm --prefix backend run build",
    "build:edge": "npm --prefix edge-backend run build",
    "build:dashboard": "npm --prefix frontend-dashboard run build",
    "build:kiosk": "npm --prefix frontend-kiosk run build",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend start",
    "serve": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "start:edge": "npm --prefix edge-backend start",
    "start:dashboard": "npm --prefix frontend-dashboard run preview",
    "start:kiosk": "npm --prefix frontend-kiosk run preview",
    "test": "npm run test:backend && npm run test:edge && npm run test:simulator",
    "test:backend": "npm --prefix backend test",
    "test:edge": "npm --prefix edge-backend test",
    "test:simulator": "npm --prefix edge-simulator test",
    "lint": "node scripts/verify-isolation.js"
  }
}
